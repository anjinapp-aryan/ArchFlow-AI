@startuml
title Shop platform
left to right direction
skinparam componentStyle rectangle
actor Customer as cust
node "Edge" {
  [Load Balancer] as lb
}
package "Services" {
  component [Order Service] as orders
  component "Payment Service" as pay
}
database "Orders DB" as db
queue "Events" as events
cloud "Stripe" as stripe
cust --> lb : HTTPS
lb -right-> orders
orders ..> events : OrderPlaced
orders --> db : SQL
orders -[#red]-> pay : charge
pay --> stripe
events <.. pay : consume
' a comment
note right of db : primary
@enduml
