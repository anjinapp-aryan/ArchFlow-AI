// Cloudflare Workers Static Assets deployment of the ArchFlow web app.
// No Worker script: every request is served from apps/web/dist (free, unlimited static requests).
// Security headers come from apps/web/dist/_headers (generated by `npm run web:build`).
//
// Target URL: https://app.archflow-ai.workers.dev = Worker name "app" + account workers.dev
// subdomain "archflow-ai". The subdomain is an ACCOUNT setting, so ArchFlow needs its own
// Cloudflare account (the first deployment shared an account with another project).
// Deploy only with `npm run deploy` (GitHub Actions job "deploy" runs it on main). It refuses
// any account other than the dedicated one below. See docs/architecture/DEPLOYMENT.md.
{
  "name": "app",
  "account_id": "cd9e6a7f8d05ccfc5de8d27f3e33c53b",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
