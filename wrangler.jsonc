// Cloudflare Workers Static Assets deployment of the ArchFlow web app.
// No Worker script: every request is served from apps/web/dist (free, unlimited static requests).
// Security headers come from apps/web/dist/_headers (generated by `npm run web:build`).
// Deploying requires the owner's Cloudflare account and explicit authorization; see docs/architecture/DEPLOYMENT.md.
{
  "name": "archflow-ai",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
