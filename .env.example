# ArchFlow AI local environment. Copy to .env.local (git-ignored) and fill in.
# Read only by the local server (`npm run web:serve`) for "Convert to Instructions";
# keys stay in that server process and are never sent to the browser.

# "failover" tries the providers in LLM_PROVIDER_ORDER; or name one provider (gemini, groq, nvidia).
LLM_PROVIDER=failover
LLM_PROVIDER_ORDER=gemini,groq,nvidia

# A provider whose key or model is empty is skipped.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-model-name
GROQ_API_KEY=
GROQ_MODEL=groq-model-name
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia-model-name

# Optional: per-provider timeout in milliseconds (1000-120000, default 30000).
# ARCHFLOW_LLM_TIMEOUT_MS=30000
